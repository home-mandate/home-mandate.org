{
  "name": "mandate-spec.org",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": "^24"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "scripts": {
    "languages": "node scripts/languages.ts",
    "spec": "node scripts/import-spec.ts",
    "prepare-site": "pnpm languages && pnpm spec && svelte-kit sync && pnpm assets",
    "dev": "pnpm prepare-site && vite dev",
    "build": "pnpm prepare-site && vite build && node scripts/check-build.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "pnpm prepare-site && svelte-kit sync && eslint .",
    "typecheck": "pnpm prepare-site && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "pnpm prepare-site && vitest run --coverage",
    "e2e": "playwright test",
    "assets": "node scripts/assets.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "2.25.4",
    "@inlang/plugin-icu1": "1.1.0",
    "@mandate-spec/mandate-spec": "github:mandate-spec/mandate-spec-ts#1cdfc014c9229cd320ab1f7e421f03b750cca59c",
    "@messageformat/parser": "5.1.1",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.2",
    "altcha": "3.2.3",
    "eslint": "10.11.0",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "marked": "18.0.14",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
